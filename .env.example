##############################################################################
# Hadhi Noor Mohamed H — Portfolio & CMS
# Copy this file to ".env" at the repository root and fill in real values.
# NEVER commit the real .env file.
#
# Vercel / production notes:
#   - Vercel cannot reach `localhost`. Use a hosted PostgreSQL provider
#     (Neon, Supabase, Prisma Postgres, Railway, ...) for DATABASE_URL.
#   - Vercel has an ephemeral filesystem. Set STORAGE_DRIVER=s3 and the S3_*
#     variables for media uploads; the local driver is for development/Docker.
#   - Set APP_ORIGIN and SITE_URL to the deployed HTTPS URL.
#   - Set TRUST_PROXY=true and COOKIE_SECURE=true.
#   - Run migrations/seed once against the hosted database:
#       npm run db:deploy && npm run db:seed
##############################################################################

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Local development only. Vercel sets NODE_ENV=production automatically; do
# not copy this value into the Vercel dashboard.
NODE_ENV=development
# Public port the API server listens on
PORT=4000
# Public origin of the built frontend (used for CORS + CSRF origin checks).
# In development Vite runs on 5173 and proxies /api to the server.
APP_ORIGIN=http://localhost:5173
# Canonical production URL of the website (used for SEO / sitemap / OG tags).
SITE_URL=http://localhost:5173
# Comma separated extra origins allowed by CORS (optional)
CORS_EXTRA_ORIGINS=

# ---------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# ---------------------------------------------------------------------------
# Production / docker-compose example. On Vercel this MUST be a hosted
# PostgreSQL URL (Neon, Supabase, Prisma Postgres, Railway, ...) - localhost is
# not reachable from a Vercel Function.
# DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public

# --- docker-compose only (the "db" service reads these) ---------------------
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Sessions & security
# ---------------------------------------------------------------------------
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string
SESSION_TTL_HOURS=12
# Trust the reverse proxy. Set true behind nginx / a PaaS load balancer / Vercel.
TRUST_PROXY=false
# cookie domain (leave empty for host-only cookie)
COOKIE_DOMAIN=
# HTTPS-only session cookies. Must be true on Vercel/HTTPS. It already defaults
# to true when NODE_ENV=production, so never set it to false in production.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Owner bootstrap (used once by `npm run setup:owner`)
# No default credentials are shipped. Change immediately after first login.
# ---------------------------------------------------------------------------
OWNER_EMAIL=hadhinoor129@gmail.com
OWNER_NAME=Hadhi Noor Mohamed H
OWNER_PASSWORD=

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# "local" (development default) or "s3" (any S3 compatible provider:
# AWS S3, Cloudflare R2, Backblaze B2, MinIO, DigitalOcean Spaces ...)
STORAGE_DRIVER=local
# Directory used by the local driver (relative to the server workspace)
LOCAL_STORAGE_DIR=storage
# Public base URL that serves local uploads (in development the API serves them)
LOCAL_STORAGE_PUBLIC_URL=http://localhost:4000
# Max upload size in megabytes
UPLOAD_MAX_MB=25

# --- S3 / S3-compatible provider (required when STORAGE_DRIVER=s3) ----------
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Set true for MinIO / local S3 that requires path-style addressing
S3_FORCE_PATH_STYLE=false
# Seconds before a private (signed) URL expires
S3_SIGNED_URL_TTL=900

# ---------------------------------------------------------------------------
# Optional integrations (all degrade gracefully when unset)
# ---------------------------------------------------------------------------
# Server-side GitHub adapter: personal access token (read-only, public_repo)
GITHUB_TOKEN=
GITHUB_USERNAME=
# Contact form spam protection: number of submissions allowed per IP per hour
CONTACT_RATE_LIMIT_PER_HOUR=5
# Analytics: set true to include analytics in privacy disclosure
ANALYTICS_ENABLED=true
