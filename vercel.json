{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run db:generate && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api?__path=" },
    { "source": "/api/:path*", "destination": "/api?__path=:path*" },
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/favicon.png", "destination": "/favicon.svg" },
    { "source": "/:path((?!api/|uploads/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
